# Absolute origin. Canonicals, Open Graph URLs, sitemaps and llms.txt are all
# built from this, so it must be the real production origin with no trailing slash.
SITE_URL=https://localsknow.com.au

# Stamped into every "checked on" line, every dateModified and every sitemap
# lastmod. Leave unset and the build uses today.
# BUILD_DATE=2026-08-18

# Google Places API (New). Optional. Without it, listing pages link out to the
# business's Google profile instead of showing a star rating, which is the
# intended fallback. See scripts/fetch-places.mjs.
GOOGLE_MAPS_API_KEY=

# Supabase, for when the data layer moves off JSON. src/lib/repo.ts is the only
# file that has to change.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Licence verification pipelines. Not wired up yet.
NSW_FAIR_TRADING_API_KEY=
VBA_REGISTER_API_KEY=
ABR_GUID=
