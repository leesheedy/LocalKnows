---
/**
 * The only layout.
 *
 * Every page passes a page kind and its own facts; the head is assembled here so
 * canonical, robots, Open Graph and JSON-LD can never drift apart between page
 * types. If something belongs in <head>, it belongs in this file.
 */
import { SITE } from '~/lib/site';
import { decide, robotsContent, type PageKind } from '~/lib/indexability';
import { abs, title as fitTitle, description as fitDescription, type Crumb } from '~/lib/seo';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import '~/styles/global.css';

interface Props {
  kind: PageKind;
  title: string;
  /**
   * Shorter titles to fall back on, in descending order of usefulness, when the
   * one above will not fit inside Google's line. See `title` in lib/seo.ts.
   */
  titleAlt?: string[];
  description: string;
  /** Path only, with a trailing slash. Canonical is built from it. */
  canonicalPath: string;
  crumbs?: Crumb[];
  jsonLd?: unknown;
  ogImage?: string;
  /** Real pixel size of ogImage. Defaults to the 1200x630 generated card. */
  ogImageSize?: { width: number; height: number };
  ogType?: 'website' | 'article';
  listingCount?: number;
  basedCount?: number;
  qualityScore?: number;
  page?: number;
  isPast?: boolean;
  utility?: boolean;
  /** Rendered above the breadcrumbs. Used by paginated and filtered views. */
  prev?: string;
  next?: string;
  publishedAt?: string;
  modifiedAt?: string;
  wide?: boolean;
}

const {
  kind,
  title,
  titleAlt = [],
  description,
  canonicalPath,
  crumbs = [],
  jsonLd,
  ogImage,
  ogImageSize,
  ogType = 'website',
  listingCount,
  basedCount,
  qualityScore,
  page,
  isPast,
  utility,
  prev,
  next,
  publishedAt,
  modifiedAt,
} = Astro.props;

const decision = decide({ kind, listingCount, basedCount, qualityScore, page, isPast, utility });
const canonical = abs(canonicalPath);
const metaTitle = fitTitle([title, ...titleAlt]);
const metaDescription = fitDescription(description);
const image = abs(ogImage ?? '/og/default.png');

/**
 * The declared dimensions have to be the dimensions of the file.
 *
 * These were hardcoded to 1200x630, which is right for the generated cards in
 * /og/ and wrong for the six hundred listing pages that prefer the business's
 * own photograph. A share card built to the wrong aspect ratio gets cropped by
 * whatever is reading it, usually straight through the middle of the subject.
 */
const OG_CARD = { width: 1200, height: 630 };
const imageSize = ogImageSize ?? OG_CARD;
const imageType = /\.jpe?g$/i.test(image)
  ? 'image/jpeg'
  : /\.webp$/i.test(image)
    ? 'image/webp'
    : 'image/png';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent(decision)} />

    {/* Fonts are same origin, so a preload beats a preconnect. */}
    <link
      rel="preload"
      href="/fonts/instrument-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {prev && <link rel="prev" href={abs(prev)} />}
    {next && <link rel="next" href={abs(next)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageSize.width)} />
    <meta property="og:image:height" content={String(imageSize.height)} />
    <meta property="og:image:alt" content={title} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image} />

    {/*
      Google assembles the site name it shows above a result from several signals
      at once, and disagreement between them is how a result ends up labelled
      with a bare domain. These say the same thing as og:site_name, the WebSite
      node and the manifest, deliberately.
    */}
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />

    <meta name="theme-color" content="#EFEDE4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131E19" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="AU-NSW" />
    <meta name="geo.placename" content="New South Wales and Victoria, Australia" />

    {/*
      Favicon, ordered for the fetchers rather than for tidiness.

      Google's SERP icon crawler wants a square raster whose side is a multiple
      of 48, and it will ask for /favicon.ico at the root whether or not a link
      declares one, so the ICO ships 16, 32 and 48 and goes first. The SVG is
      what a browser tab actually uses, where it stays sharp at any zoom and any
      device pixel ratio. Android pulls its sizes from the manifest, so the 192
      and 512 PNGs are declared there and not repeated here.
    */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name + ' wire'} href="/wire/rss.xml" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

    {/*
      Policy decision is emitted so it can be asserted in the build verifier and
      read straight off a live page during an audit. Cheap, and it makes the
      indexation rules testable rather than a claim in a document.
    */}
    <meta name="lk:index-reason" content={decision.reason} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    {crumbs.length > 0 && (
      <div class="wrap">
        <Breadcrumbs crumbs={crumbs} />
      </div>
    )}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Mobile nav. Nine lines of inline script rather than a framework island.
      document.addEventListener('click', function (e) {
        var t = e.target.closest('.navtoggle');
        if (!t) return;
        var bar = t.closest('.bar');
        var open = bar.classList.toggle('open');
        t.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    </script>
  </body>
</html>
