---
/**
 * The measurement and money calculators.
 *
 * All of them are the same shape: a handful of numeric inputs, a formula, and a
 * set of answer rows. One shell, one config per calculator.
 *
 * The formulas themselves live in src/lib/calculators.mjs and are serialised
 * into the page here. That indirection exists for one reason: while they were
 * inline in this file nothing could import them, so nothing could test them,
 * and a formula nobody can run in isolation is a formula nobody has checked.
 * scripts/selftest.mjs now imports the same objects and asserts them against
 * hand worked answers.
 */
import { CALCULATORS, CALCULATOR_SLUGS } from '~/lib/calculators.mjs';

interface Props {
  slug: string;
}
const { slug } = Astro.props;

const spec = (CALCULATORS as Record<string, any>)[slug];

/**
 * JSON cannot carry a function, so the calc is serialised with toString() and
 * the whole spec is assembled as a JS literal. Everything in it comes from this
 * repository, never from user input.
 */
const specLiteral = spec
  ? '{headlineLabel:' +
    JSON.stringify(spec.headlineLabel) +
    ',fields:' +
    JSON.stringify(spec.fields) +
    ',calc:' +
    spec.calc.toString() +
    '}'
  : 'null';
---

{spec && (
  <>
    <div class="tw" id="tw-calc">
      <div class="tw-cols" id="calc-fields"></div>
      <div class="tw-out">
        <div class="tw-bigline">
          <span class="mono" id="calc-headline-label">{spec.headlineLabel}</span>
          <b id="calc-headline">—</b>
        </div>
        <table class="tw-table tw-break">
          <tbody id="calc-rows"></tbody>
        </table>
        <p class="tw-note" id="calc-note"></p>
      </div>
    </div>

    <script is:inline set:html={`
      (function () {
        var root = document.getElementById('tw-calc');
        if (!root) return;
        var spec = ${specLiteral};
        if (!spec) return;

        var fmt = {
          n2: function (v) {
            if (!isFinite(v)) return '0.00';
            return v.toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          },
          money: function (v) {
            if (!isFinite(v)) return '$0.00';
            return '$' + v.toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          },
          whole: function (v) {
            if (!isFinite(v)) return '0';
            return Math.ceil(v).toLocaleString('en-AU');
          }
        };

        var wrap = document.getElementById('calc-fields');
        var half = Math.ceil(spec.fields.length / 2);
        var cols = [document.createElement('div'), document.createElement('div')];

        spec.fields.forEach(function (f, i) {
          var d = document.createElement('div');
          d.className = 'tw-field';
          var isMoney = f.unit && f.unit.indexOf('$') === 0;
          var prefix = isMoney ? '<span aria-hidden="true">$</span>' : '';
          var tail = isMoney ? f.unit.slice(1) : f.unit;
          var suffix = tail ? '<span aria-hidden="true">' + tail + '</span>' : '';
          d.innerHTML =
            '<label class="mono" for="f-' + f.id + '">' + f.label + '</label>' +
            '<div class="tw-money">' + prefix +
            '<input id="f-' + f.id + '" type="number" inputmode="decimal" min="0" step="' + f.step + '" value="' + f.value + '">' +
            suffix + '</div>';
          cols[i < half ? 0 : 1].appendChild(d);
        });
        wrap.appendChild(cols[0]);
        wrap.appendChild(cols[1]);

        function run() {
          var v = {};
          spec.fields.forEach(function (f) {
            var el = document.getElementById('f-' + f.id);
            var num = Number(el.value);
            v[f.id] = isFinite(num) ? num : 0;
          });
          var out = spec.calc(v, fmt);
          document.getElementById('calc-headline').textContent = out.headline;
          document.getElementById('calc-rows').innerHTML = out.rows
            .map(function (r, i) {
              var last = i === out.rows.length - 1;
              return (
                '<tr' + (last ? ' class="tw-rule"' : '') + '><th scope="row">' + r[0] +
                (r[2] ? '<span class="tw-sub">' + r[2] + '</span>' : '') +
                '</th><td class="tw-num">' + r[1] + '</td></tr>'
              );
            })
            .join('');
          document.getElementById('calc-note').textContent = out.note;
        }

        root.addEventListener('input', run);
        run();
      })();
    `} />
  </>
)}
