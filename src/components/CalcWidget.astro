---
/**
 * The measurement and money calculators.
 *
 * All of them are the same shape: a handful of numeric inputs, a formula, and a
 * set of answer rows. Writing seven bespoke widgets would have been seven times
 * the code and seven chances for the markup to drift, so there is one shell and
 * a config per calculator.
 *
 * Every formula here is arithmetic on published trade conventions, not an
 * estimate of what a job costs. Where a convention varies by product, the
 * assumption is an input with a sensible default rather than a constant buried
 * in the code, so anyone can put their own figure in.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;

/** Slugs this component knows how to render. */
export const CALCULATOR_SLUGS = [
  'concrete-calculator',
  'paint-calculator',
  'soil-and-mulch-calculator',
  'fence-calculator',
  'decking-calculator',
  'contractor-rate-calculator',
  'markup-and-margin-calculator',
];

const known = CALCULATOR_SLUGS.includes(slug);
---

{known && (
  <>
    <div class="tw" id="tw-calc" data-calc={slug}>
      <div class="tw-cols" id="calc-fields"></div>
      <div class="tw-out">
        <div class="tw-bigline">
          <span class="mono" id="calc-headline-label">Result</span>
          <b id="calc-headline">—</b>
        </div>
        <table class="tw-table tw-break">
          <tbody id="calc-rows"></tbody>
        </table>
        <p class="tw-note" id="calc-note"></p>
      </div>
    </div>

    <script is:inline>
      (function () {
        var root = document.getElementById('tw-calc');
        if (!root) return;

        var n2 = function (v) {
          return v.toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        };
        var money = function (v) { return '$' + n2(v); };
        var whole = function (v) { return Math.ceil(v).toLocaleString('en-AU'); };

        /**
         * Each calculator declares its inputs and a compute function returning
         * { headline, headlineLabel, rows, note }. Rows are [label, value, note].
         */
        var CALCS = {
          'concrete-calculator': {
            headlineLabel: 'Concrete needed',
            fields: [
              { id: 'len', label: 'Length', unit: 'm', value: 6, step: 0.1 },
              { id: 'wid', label: 'Width', unit: 'm', value: 4, step: 0.1 },
              { id: 'dep', label: 'Depth', unit: 'mm', value: 100, step: 5 },
              { id: 'waste', label: 'Allowance for spillage and uneven ground', unit: '%', value: 10, step: 1 },
            ],
            calc: function (v) {
              var m3 = v.len * v.wid * (v.dep / 1000);
              var withWaste = m3 * (1 + v.waste / 100);
              // A 20kg bag of premix yields about 9 litres of wet concrete, so
              // roughly 111 bags to the cubic metre. Premix is only sensible on
              // small pours; past about a third of a cubic metre it is cheaper
              // and far less work to order a truck.
              var bags20 = withWaste / 0.009;
              return {
                headline: n2(withWaste) + ' m³',
                rows: [
                  ['Slab volume', n2(m3) + ' m³', v.len + 'm x ' + v.wid + 'm x ' + v.dep + 'mm'],
                  ['Allowance', n2(withWaste - m3) + ' m³', v.waste + '%'],
                  ['Order this much', n2(withWaste) + ' m³', 'Trucks are usually sold in 0.2 m³ steps'],
                  ['Or 20kg premix bags', whole(bags20), 'About 111 bags to the cubic metre'],
                  ['Surface area', n2(v.len * v.wid) + ' m²', ''],
                ],
                note:
                  withWaste > 0.4
                    ? 'At ' + n2(withWaste) + ' m³ this is a truck job. Premix bags are for pours under about a third of a cubic metre; past that the bag count and the mixing time stop making sense. Ring a supplier with the volume and they will tell you the minimum load.'
                    : 'At ' + n2(withWaste) + ' m³ this is small enough for bagged premix. Mix to the bag instructions rather than by eye, because the water ratio is what decides the strength.',
              };
            },
          },

          'paint-calculator': {
            headlineLabel: 'Paint needed',
            fields: [
              { id: 'peri', label: 'Total wall length', unit: 'm', value: 24, step: 0.5 },
              { id: 'hgt', label: 'Wall height', unit: 'm', value: 2.4, step: 0.1 },
              { id: 'openings', label: 'Doors and windows to deduct', unit: 'm²', value: 6, step: 0.5 },
              { id: 'coats', label: 'Coats', unit: '', value: 2, step: 1 },
              { id: 'spread', label: 'Spread rate on the tin', unit: 'm²/L', value: 16, step: 1 },
            ],
            calc: function (v) {
              var gross = v.peri * v.hgt;
              var net = Math.max(0, gross - v.openings);
              var litres = v.spread > 0 ? (net * v.coats) / v.spread : 0;
              return {
                headline: n2(litres) + ' L',
                rows: [
                  ['Wall area', n2(gross) + ' m²', v.peri + 'm of wall at ' + v.hgt + 'm'],
                  ['Less openings', '-' + n2(v.openings) + ' m²', 'Doors and windows'],
                  ['Area to paint', n2(net) + ' m²', ''],
                  ['Across ' + v.coats + (v.coats === 1 ? ' coat' : ' coats'), n2(net * v.coats) + ' m²', ''],
                  ['Paint required', n2(litres) + ' L', 'At ' + v.spread + ' m² per litre'],
                  ['Buy', whole(litres / 4) + ' x 4L', 'Rounded up'],
                ],
                note:
                  'Spread rate is on the tin and it varies a lot: 16 m² per litre is typical for a topcoat on a sealed wall, and bare plasterboard, render or a dark colour going lighter will all take more. Sealer or undercoat is extra again and is not counted here.',
              };
            },
          },

          'soil-and-mulch-calculator': {
            headlineLabel: 'Volume needed',
            fields: [
              { id: 'len', label: 'Length', unit: 'm', value: 5, step: 0.1 },
              { id: 'wid', label: 'Width', unit: 'm', value: 3, step: 0.1 },
              { id: 'dep', label: 'Depth', unit: 'mm', value: 75, step: 5 },
            ],
            calc: function (v) {
              var m3 = v.len * v.wid * (v.dep / 1000);
              return {
                headline: n2(m3) + ' m³',
                rows: [
                  ['Area', n2(v.len * v.wid) + ' m²', v.len + 'm x ' + v.wid + 'm'],
                  ['Volume', n2(m3) + ' m³', 'At ' + v.dep + 'mm deep'],
                  ['In litres', whole(m3 * 1000) + ' L', '1 m³ is 1000 litres'],
                  ['25L bags', whole(m3 * 40), '40 bags to the cubic metre'],
                  ['50L bags', whole(m3 * 20), '20 bags to the cubic metre'],
                  ['Trailer loads', n2(m3 / 0.7) + ' loads', 'A 6x4 trailer holds roughly 0.7 m³ level'],
                ],
                note:
                  'Mulch settles, so garden beds are usually done at 50 to 75mm and topped up rather than laid thick once. Turf underlay and topsoil go deeper. Bulk by the cubic metre is cheaper than bags past about half a cubic metre, and most suppliers on the border deliver.',
              };
            },
          },

          'fence-calculator': {
            headlineLabel: 'Materials',
            fields: [
              { id: 'run', label: 'Fence length', unit: 'm', value: 20, step: 0.5 },
              { id: 'spacing', label: 'Post spacing', unit: 'm', value: 2.4, step: 0.1 },
              { id: 'paling', label: 'Paling width', unit: 'mm', value: 90, step: 5 },
              { id: 'gap', label: 'Gap between palings', unit: 'mm', value: 0, step: 1 },
              { id: 'rails', label: 'Rails per bay', unit: '', value: 3, step: 1 },
            ],
            calc: function (v) {
              var bays = v.spacing > 0 ? Math.ceil(v.run / v.spacing) : 0;
              var posts = bays + 1;
              var railLength = bays * v.spacing * v.rails;
              var pitch = v.paling + v.gap;
              var palings = pitch > 0 ? Math.ceil((v.run * 1000) / pitch) : 0;
              return {
                headline: posts + ' posts',
                rows: [
                  ['Bays', bays, 'At ' + v.spacing + 'm centres'],
                  ['Posts', posts, 'One more than the bay count'],
                  ['Rails', bays * v.rails, v.rails + ' per bay'],
                  ['Rail length', n2(railLength) + ' m', 'Total linear metres'],
                  ['Palings', palings, v.paling + 'mm wide' + (v.gap > 0 ? ' at ' + v.gap + 'mm gaps' : ', butted')],
                  ['Concrete for posts', n2(posts * 0.02) + ' m³', 'About 20L a hole for a 300mm x 600mm hole'],
                ],
                note:
                  'Counts assume a straight run. Every corner and every gate adds a post, and a gate needs a heavier one. Post spacing of 2.4m is the usual maximum for a paling fence; going wider makes the rails sag. Dividing fences between neighbours are covered by fencing law in both states and the cost is normally shared, so talk to the neighbour before you order.',
              };
            },
          },

          'decking-calculator': {
            headlineLabel: 'Decking boards',
            fields: [
              { id: 'len', label: 'Deck length', unit: 'm', value: 6, step: 0.1 },
              { id: 'wid', label: 'Deck width', unit: 'm', value: 4, step: 0.1 },
              { id: 'board', label: 'Board width', unit: 'mm', value: 90, step: 5 },
              { id: 'gap', label: 'Gap between boards', unit: 'mm', value: 4, step: 1 },
              { id: 'joist', label: 'Joist spacing', unit: 'mm', value: 450, step: 50 },
              { id: 'waste', label: 'Waste allowance', unit: '%', value: 10, step: 1 },
            ],
            calc: function (v) {
              var area = v.len * v.wid;
              var pitch = v.board + v.gap;
              var rows = pitch > 0 ? Math.ceil((v.wid * 1000) / pitch) : 0;
              var linear = rows * v.len;
              var withWaste = linear * (1 + v.waste / 100);
              var joists = v.joist > 0 ? Math.ceil((v.len * 1000) / v.joist) + 1 : 0;
              return {
                headline: n2(withWaste) + ' lineal m',
                rows: [
                  ['Deck area', n2(area) + ' m²', v.len + 'm x ' + v.wid + 'm'],
                  ['Board runs', rows, v.board + 'mm boards at ' + v.gap + 'mm gaps'],
                  ['Decking, before waste', n2(linear) + ' lineal m', ''],
                  ['Order', n2(withWaste) + ' lineal m', v.waste + '% waste allowance'],
                  ['Joists', joists, 'At ' + v.joist + 'mm centres'],
                  ['Joist length', n2(joists * v.wid) + ' lineal m', ''],
                ],
                note:
                  'Joist spacing depends on the board. Most 19mm hardwood decking is rated to 450mm centres and thinner or composite boards often want 400mm or less, so check what the supplier specifies before you set out the frame. Gaps of 3 to 5mm suit seasoned hardwood; unseasoned timber is laid tighter because it shrinks.',
              };
            },
          },

          'contractor-rate-calculator': {
            headlineLabel: 'Charge at least',
            fields: [
              { id: 'income', label: 'Income you want to take home, before tax', unit: '$/yr', value: 90000, step: 1000 },
              { id: 'overheads', label: 'Business overheads a year', unit: '$/yr', value: 25000, step: 500 },
              { id: 'hours', label: 'Billable hours a week', unit: 'hrs', value: 25, step: 1 },
              { id: 'weeks', label: 'Weeks worked a year', unit: '', value: 46, step: 1 },
              { id: 'super', label: 'Superannuation you pay yourself', unit: '%', value: 12, step: 0.5 },
            ],
            calc: function (v) {
              var billable = v.hours * v.weeks;
              var superAmt = v.income * (v.super / 100);
              var required = v.income + v.overheads + superAmt;
              var rate = billable > 0 ? required / billable : 0;
              var incGst = rate * 1.1;
              return {
                headline: money(rate) + '/hr',
                rows: [
                  ['Income target', money(v.income), 'Before income tax'],
                  ['Superannuation', money(superAmt), v.super + '% of the income target'],
                  ['Overheads', money(v.overheads), 'Insurance, vehicle, tools, phone, accounting, registration'],
                  ['Total to recover', money(required), ''],
                  ['Billable hours a year', whole(billable), v.hours + ' a week over ' + v.weeks + ' weeks'],
                  ['Minimum rate, before GST', money(rate) + '/hr', ''],
                  ['Rate with GST', money(incGst) + '/hr', 'If you are registered for GST'],
                  ['A 6 hour day at that rate', money(rate * 6), ''],
                ],
                note:
                  'The number people get wrong is billable hours. Quoting, invoicing, chasing payment, driving, buying materials and cleaning the ute are all unpaid, and for most sole trader trades the billable share of a 45 hour week is somewhere between 20 and 30 hours. Halving your assumed billable hours roughly doubles the rate you need, which is why a rate that looks high next to an employee wage usually is not.',
              };
            },
          },

          'markup-and-margin-calculator': {
            headlineLabel: 'Sell price',
            fields: [
              { id: 'cost', label: 'What it costs you', unit: '$', value: 100, step: 5 },
              { id: 'markup', label: 'Markup on cost', unit: '%', value: 30, step: 1 },
            ],
            calc: function (v) {
              var price = v.cost * (1 + v.markup / 100);
              var profit = price - v.cost;
              var margin = price > 0 ? (profit / price) * 100 : 0;
              // The rate that would be needed for markup and margin to agree.
              var markupForSameMargin = v.markup < 100 ? (v.markup / (1 - v.markup / 100)) : 0;
              return {
                headline: money(price),
                rows: [
                  ['Cost', money(v.cost), ''],
                  ['Markup', money(profit), v.markup + '% of cost'],
                  ['Sell price, before GST', money(price), ''],
                  ['Gross margin', n2(margin) + '%', 'Profit as a share of the sell price'],
                  ['Sell price with GST', money(price * 1.1), ''],
                  ['For a ' + v.markup + '% MARGIN instead', money(markupForSameMargin > 0 ? v.cost * (1 + markupForSameMargin / 100) : 0), markupForSameMargin > 0 ? 'Needs a ' + n2(markupForSameMargin) + '% markup' : 'A margin of 100% or more is not achievable'],
                ],
                note:
                  'Markup and margin are not the same number and mixing them up is how a business quietly loses money. A 30% markup is a 23% margin. To actually make a 30% margin you need a 43% markup. If your accountant talks in margin and your supplier talks in markup, one of you is being misunderstood.',
              };
            },
          },
        };

        var spec = CALCS[root.dataset.calc];
        if (!spec) return;

        var wrap = document.getElementById('calc-fields');
        var half = Math.ceil(spec.fields.length / 2);
        var cols = [document.createElement('div'), document.createElement('div')];
        spec.fields.forEach(function (f, i) {
          var d = document.createElement('div');
          d.className = 'tw-field';
          var isMoney = f.unit && f.unit.indexOf('$') === 0;
          var unit = isMoney ? '<span aria-hidden="true">$</span>' : '';
          var tail = isMoney ? f.unit.slice(1) : f.unit;
          var suffix = tail ? '<span aria-hidden="true">' + tail + '</span>' : '';
          d.innerHTML =
            '<label class="mono" for="f-' + f.id + '">' + f.label + '</label>' +
            '<div class="tw-money">' + unit +
            '<input id="f-' + f.id + '" type="number" inputmode="decimal" min="0" step="' + f.step + '" value="' + f.value + '">' +
            suffix + '</div>';
          cols[i < half ? 0 : 1].appendChild(d);
        });
        wrap.appendChild(cols[0]);
        wrap.appendChild(cols[1]);

        document.getElementById('calc-headline-label').textContent = spec.headlineLabel;

        function run() {
          var v = {};
          spec.fields.forEach(function (f) {
            v[f.id] = Number(document.getElementById('f-' + f.id).value || 0);
          });
          var out = spec.calc(v);
          document.getElementById('calc-headline').textContent = out.headline;
          document.getElementById('calc-rows').innerHTML = out.rows
            .map(function (r, i) {
              var last = i === out.rows.length - 1;
              return (
                '<tr' + (last ? ' class="tw-rule"' : '') + '><th scope="row">' + r[0] +
                (r[2] ? '<span class="tw-sub">' + r[2] + '</span>' : '') +
                '</th><td class="tw-num">' + r[1] + '</td></tr>'
              );
            })
            .join('');
          document.getElementById('calc-note').textContent = out.note;
        }

        root.addEventListener('input', run);
        run();
      })();
    </script>
  </>
)}
