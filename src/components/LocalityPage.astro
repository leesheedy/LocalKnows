---
/**
 * Locality hub. The page that has to link to everything below it without
 * turning into a wall of 400 links.
 *
 * It also has to be worth indexing in its own right, which for most of 2026 it
 * was not: Albury, Wodonga, Wangaratta and Beechworth all sat in "crawled,
 * currently not indexed" with a blurb, a stat row and a grid of category links
 * that read the same in every town. What makes a town page different from the
 * next one is what its own rows say, so the top of the page now says it: an
 * "In short" paragraph, an at a glance block, and FAQs answered by counting.
 * All of it comes from localityStats() in repo.ts and the sentences from
 * copy.ts, so the summary, the block, the FAQ and the meta description are one
 * set of numbers.
 */
import type { Locality } from '~/lib/types';
import {
  url,
  STATES,
  getRegion,
  activeCategoriesInLocality,
  indexedMoneyPagesIn,
  hasTownGuide,
  hasHiddenGems,
  themesFor,
  listingsInLocality,
  localityStats,
  neighboursOf,
  listsForLocality,
  eventsInLocality,
  guides as allGuides,
} from '~/lib/repo';
import { VERTICALS } from '~/lib/site';
import Base from '~/layouts/Base.astro';
import ListingCard from '~/components/ListingCard.astro';
import Faq from '~/components/Faq.astro';
import LinkBlock from '~/components/LinkBlock.astro';
import {
  checkedPhrase,
  counted,
  kmLabel,
  otherStateLabel,
  n,
  plural,
  townDescription,
  townFaqs,
  townInShort,
  townTitleLadder,
} from '~/lib/copy';
import { humanDate, shortDate } from '~/lib/build';
import {
  graph,
  organisationNode,
  websiteNode,
  breadcrumbNode,
  webPageNode,
  placeNode,
  faqNode,
  itemListNode,
  ogForState,
  type Crumb,
} from '~/lib/seo';

interface Props {
  locality: Locality;
  buildDate: string;
}
const { locality, buildDate } = Astro.props;

const state = STATES[locality.state];
const region = getRegion(locality.regionId);
const canonicalPath = url.locality(locality);

const rows = listingsInLocality(locality.id);
const active = activeCategoriesInLocality(locality.id);
const stats = localityStats(locality.id);
const verified = stats.verifiedCount;
const travelIn = stats.travelInCount;
const otherState = otherStateLabel(locality.state);

const byVertical = VERTICALS.map((v) => ({
  vertical: v,
  items: active.filter((a) => a.category.vertical === v.key),
})).filter((g) => g.items.length > 0);

const featured = rows.slice().sort((a, b) => b.qualityScore - a.qualityScore).slice(0, 6);
const nearby = neighboursOf(locality, 10);
// The first six by the site's usual nearby rule, which leans across the border
// on purpose so Albury reaches Wodonga before its fourth suburb, then shown
// nearest first because a list of distances out of order reads as a mistake.
const nearest = nearby.slice(0, 6).sort((a, b) => a.distanceKm - b.distanceKm);
const themes = themesFor(locality.id);
const lists = listsForLocality(locality.slug);
const events = eventsInLocality(locality.slug).filter((e) => e.startDate.slice(0, 10) >= buildDate).slice(0, 5);
const guides = allGuides
  .filter((g) => g.stateScope === 'both' || (Array.isArray(g.stateScope) && g.stateScope.includes(locality.state)))
  .slice(0, 4);

// The money pages this hub pushes hardest are the ones that are indexed.
// indexedMoneyPagesIn asks decide(), so the hub cannot promote a noindex page.
const indexedPages = indexedMoneyPagesIn(locality.id);
const glanceCategories = (indexedPages.length >= 3 ? indexedPages : active).slice(0, 6);

const h1 = 'Businesses in ' + locality.name + ', ' + locality.state;
const titles = townTitleLadder(locality, stats);
const description = townDescription(locality, stats, active);
const inShort = rows.length > 0 ? townInShort(locality, stats, active) : '';

const crumbs: Crumb[] = [
  { name: 'Home', href: url.home() },
  { name: state.name, href: url.state(locality.state) },
  ...(region ? [{ name: region.name, href: url.region(region) }] : []),
  { name: locality.name, href: canonicalPath },
];

const faqs = townFaqs({ locality, stats, nearby: nearest, asOf: buildDate });

const jsonLd = graph([
  organisationNode(),
  websiteNode(),
  breadcrumbNode(crumbs, canonicalPath),
  webPageNode({
    pageUrl: canonicalPath,
    title: h1,
    description,
    crumbs,
    type: 'CollectionPage',
    dateModified: buildDate,
    abstract: inShort || undefined,
  }),
  placeNode(locality, region),
  itemListNode({
    pageUrl: canonicalPath,
    name: 'Categories in ' + locality.name,
    items: active.slice(0, 40).map((a) => ({ url: url.localityCategory(locality, a.category), name: a.category.name + ' in ' + locality.name })),
  }),
  faqNode(faqs, canonicalPath),
]);
---

<Base
  kind="locality"
  title={titles[0]}
  titleAlt={titles.slice(1)}
  description={description}
  canonicalPath={canonicalPath}
  crumbs={crumbs}
  jsonLd={jsonLd}
  listingCount={rows.length}
  ogImage={ogForState(locality.state)}
  modifiedAt={buildDate}
>
  <div class="wrap">
    <div class="pagehead">
      <p class="eyebrow mono">
        {state.name} &middot; {region ? region.name : ''} &middot; {locality.postcode}
      </p>
      <h1>{h1}</h1>
      <p class="standfirst">{locality.blurb}</p>
      <div class="headmeta">
        <span>{n(rows.length)} {plural(rows.length, 'listing', 'listings')}</span>
        <span>&middot; {active.length} {plural(active.length, 'category', 'categories')}</span>
        {verified > 0 && <span>&middot; {verified} verified</span>}
        <span>&middot; Checked {buildDate}</span>
      </div>
    </div>

    {themes.length > 0 && (
      <nav class="chips" style="margin-top:24px" aria-label={'Ways to explore ' + locality.name}>
        {themes.map((t) => (
          <a class="chip" href={url.locality(locality) + t.slug + '/'}>{t.title(locality.name)}</a>
        ))}
      </nav>
    )}

    {(hasTownGuide(locality.id) || hasHiddenGems(locality.id)) && (
      <div class="guidecta">
        {hasTownGuide(locality.id) && (
          <a href={url.locality(locality) + 'new-in-town/'}>
            <span class="mono">Just moved here</span>
            <strong>New in {locality.name}? Start here</strong>
            <span class="sub">Where to eat, what is on, which clubs to join, and which state's rules apply.</span>
          </a>
        )}
        {hasHiddenGems(locality.id) && (
          <a href={url.locality(locality) + 'hidden-gems/'}>
            <span class="mono">Off the obvious list</span>
            <strong>Hidden gems in {locality.name}</strong>
            <span class="sub">The free ones, the clubs and the independents that a normal search will not show you.</span>
          </a>
        )}
      </div>
    )}

    {rows.length === 0 ? (
      <div class="empty" style="margin-top:30px">
        <p>Nothing listed in {locality.name} yet. It goes live when it has content, not before.</p>
        <a class="btn" href={url.claim()}>Add the first listing</a>
      </div>
    ) : (
      <>
        <div class="statgrid">
          <div><b>{n(rows.length)}</b><span>{plural(rows.length, 'listing', 'listings')}</span></div>
          <div><b>{active.length}</b><span>{plural(active.length, 'category', 'categories')}</span></div>
          {verified > 0 && <div><b>{verified}</b><span>verified</span></div>}
          {travelIn > 0 && <div><b>{travelIn}</b><span>travel in</span></div>}
          <div><b>{locality.postcode}</b><span>postcode</span></div>
        </div>

        <section class="datablock" aria-labelledby="glance-h">
          <h2 id="glance-h">{locality.name} at a glance</h2>
          <p><strong>In short.</strong> {inShort}</p>

          <div class="linkgrid" style="margin-top:18px">
            {glanceCategories.length > 0 && (
              <div>
                <h3>{glanceCategories[0].count >= 2 ? 'Biggest categories' : 'Categories'}</h3>
                <ul>
                  {glanceCategories.map((a) => (
                    <li>
                      <a href={url.localityCategory(locality, a.category)}>{a.category.name}</a>
                      <span style="color:var(--ink-40);font-size:13px"> {n(a.count)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <div>
              <h3>Based here or travelling in</h3>
              <ul>
                <li>{n(stats.basedCount)} based in {locality.name}</li>
                {stats.travelInCount > 0 && <li>{counted(stats.travelInCount, 'travels', 'travel')} in from nearby towns</li>}
                {stats.crossBorderCount > 0 && <li>{n(stats.crossBorderCount)} of those from {otherState}</li>}
                {stats.travelInInferredCount > 0 && (
                  <li style="color:var(--ink-60);font-size:13.5px">
                    {n(stats.travelInInferredCount)} on a service area we estimated from distance
                  </li>
                )}
              </ul>
            </div>
            <div>
              <h3>Weekends</h3>
              <ul>
                {stats.openSaturdayCount > 0 || stats.openSundayCount > 0 ? (
                  <>
                    <li>{counted(stats.openSaturdayCount, 'publishes', 'publish')} Saturday hours</li>
                    <li>{counted(stats.openSundayCount, 'publishes', 'publish')} Sunday hours</li>
                  </>
                ) : (
                  <li>No weekend hours published yet</li>
                )}
              </ul>
            </div>
            {(stats.pricedCount > 0 || stats.licencePublishedCount > 0) && (
              <div>
                <h3>Prices and licences</h3>
                <ul>
                  {stats.pricedCount > 0 && <li>{counted(stats.pricedCount, 'shows', 'show')} a price band or call out fee</li>}
                  {stats.licencePublishedCount > 0 && (
                    <li>
                      {counted(stats.licencePublishedCount, 'prints', 'print') +
                        ' a trade licence number, ' +
                        (stats.licenceCheckedCount > 0
                          ? n(stats.licenceCheckedCount) + ' checked against the register'
                          : 'shown as published')}
                    </li>
                  )}
                </ul>
              </div>
            )}
            {nearest.length > 0 && (
              <div>
                <h3>Nearby towns</h3>
                <ul>
                  {nearest.map((nb) => (
                    <li>
                      <a href={url.locality(nb.locality)} class={nb.crossesBorder ? 'cross' : undefined}>{nb.locality.name}</a>
                      <span style="color:var(--ink-40);font-size:13px">
                        {' '}{nb.crossesBorder ? nb.locality.state + ', ' : ''}{kmLabel(nb.distanceKm)}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <p class="asof">
            {'Counted from the ' +
              n(stats.listingCount) +
              ' ' +
              plural(stats.listingCount, 'listing', 'listings') +
              ' for ' +
              locality.name +
              ' on ' +
              humanDate(buildDate) +
              '.' +
              (checkedPhrase(stats.checkedFrom, stats.checkedTo)
                ? ' Their details were last read from the published sources ' + checkedPhrase(stats.checkedFrom, stats.checkedTo) + '.'
                : '') +
              (nearest.length ? ' Distances are straight line between town centres.' : '')}
          </p>
        </section>
      </>
    )}
  </div>

  {byVertical.map((group) => (
    <section class="sec">
      <div class="wrap">
        <div class="sec-head row">
          <div>
            <h2>{group.vertical.name} in {locality.name}</h2>
            <p>{group.vertical.blurb}</p>
          </div>
          <span class="mono" style="color:var(--ink-40)">{group.items.length} {plural(group.items.length, 'category', 'categories')}</span>
        </div>
        <div class="cats">
          {group.items.map((a) => (
            <a class="cat" href={url.localityCategory(locality, a.category)}>
              <strong>{a.category.name}</strong>
              <span class="n mono">{a.count} listed</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  {featured.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <h2>Strongest profiles in {locality.name}</h2>
          <p>
            Ordered by profile completeness and verification, not by payment.
            <a href={url.advertisingPolicy()} style="color:var(--river)"> How that works</a>.
          </p>
        </div>
        <div class="cards">
          {featured.map((l) => <ListingCard listing={l} context={locality} />)}
        </div>
      </div>
    </section>
  )}

  {(lists.length > 0 || events.length > 0) && (
    <section class="sec">
      <div class="wrap">
        <div class="linkgrid">
          {lists.length > 0 && (
            <div>
              <h3>Curated lists</h3>
              <ul>
                {lists.map((l) => <li><a href={url.list(l)}>{l.title}</a></li>)}
              </ul>
            </div>
          )}
          {events.length > 0 && (
            <div>
              <h3>Coming up in {locality.name}</h3>
              <ul>
                {events.map((e) => (
                  <li>
                    <a href={url.event(e)}>{e.title}</a>
                    <span style="color:var(--ink-40);font-size:13px"> {shortDate(e.startDate.slice(0, 10))}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {guides.length > 0 && (
            <div>
              <h3>Guides</h3>
              <ul>
                {guides.map((g) => <li><a href={url.guide(g)}>{g.title}</a></li>)}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <div class="wrap">
    <Faq faqs={faqs} heading={'Questions about ' + locality.name} />
  </div>

  <LinkBlock
    heading="Nearby"
    groups={[
      {
        heading: 'Towns near ' + locality.name,
        links: nearby.map((nb) => ({
          href: url.locality(nb.locality),
          label: nb.locality.name,
          note: nb.crossesBorder ? nb.locality.state : Math.round(nb.distanceKm) + 'km',
          cross: nb.crossesBorder,
        })),
      },
      {
        heading: 'Wider area',
        links: [
          ...(region ? [{ href: url.region(region), label: 'All of ' + region.name }] : []),
          { href: url.state(locality.state), label: state.name },
          { href: url.state(locality.state === 'NSW' ? 'VIC' : 'NSW'), label: otherStateLabel(locality.state), cross: true },
          { href: url.categoryIndex(), label: 'Every category' },
        ],
      },
    ]}
  />
</Base>
