---
import type { Crumb } from '~/lib/seo';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i === crumbs.length - 1 ? (
          <span aria-current="page">{c.name}</span>
        ) : (
          <a href={c.href}>{c.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
