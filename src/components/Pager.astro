---
interface Props { current: number; total: number; hrefFor: (page: number) => string }
const { current, total, hrefFor } = Astro.props;
const window = 2;
const pages: number[] = [];
for (let p = 1; p <= total; p++) {
  if (p === 1 || p === total || Math.abs(p - current) <= window) pages.push(p);
}
---
{total > 1 && (
  <nav class="pager" aria-label="Pagination">
    {current > 1 && <a href={hrefFor(current - 1)} rel="prev">Previous</a>}
    {pages.map((p, i) => (
      <>
        {i > 0 && pages[i - 1] !== p - 1 && <span aria-hidden="true">…</span>}
        {p === current ? (
          <span aria-current="page">{p}</span>
        ) : (
          <a href={hrefFor(p)}>{p}</a>
        )}
      </>
    ))}
    {current < total && <a href={hrefFor(current + 1)} rel="next">Next</a>}
  </nav>
)}
