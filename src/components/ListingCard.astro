---
import type { Category, Listing, Locality } from '~/lib/types';
import { url, averageRating, getCategory, getLocality } from '~/lib/repo';
import { listingMedia } from '~/lib/media';
import { description as fitDescription } from '~/lib/seo';

interface Props {
  listing: Listing;
  /** The locality page this card is being shown on, for the travel note. */
  context?: Locality;
  category?: Category;
  showState?: boolean;
  /**
   * Heading level for the business name. 2 where the grid is the page's own
   * content and sits straight under the h1; 3 where it is a "nearby" or
   * "similar" block underneath a section heading of its own.
   *
   * Cards were always h3, which on every money page produced h1 followed by
   * h3 with no h2 between them. Thirty pages announced a level of structure
   * that was not there, which is what a screen reader navigates by.
   */
  headingLevel?: 2 | 3;
}
const { listing, context, category, showState = true, headingLevel = 3 } = Astro.props;
const Heading = ('h' + headingLevel) as 'h2' | 'h3';

const home = getLocality(listing.localityId);
const primary = category ?? getCategory(listing.categoryIds[0]);
const rating = listing.google?.rating ?? averageRating(listing);
const reviewCount = listing.google?.reviewCount ?? listing.reviews.length;
const travelsIn = context && home && home.id !== context.id;
const crossesBorder = context && home && home.state !== context.state;
const openDays = listing.hours.filter((h) => !h.closed);
const weekend = listing.hours.find((h) => h.day === 6 && !h.closed);
const media = listingMedia(listing);
const travelNote = travelsIn
  ? listing.serviceAreaInferred
    ? crossesBorder
      ? 'In range across the border'
      : 'In range of ' + context!.name
    : crossesBorder
      ? 'Crosses the border to ' + context!.name
      : 'Travels to ' + context!.name
  : null;
---
<article class="card">
  <div class="card-top">
    {media.logo ? (
      <img
        class="logo"
        src={media.logo.src}
        alt=""
        width={media.logo.width}
        height={media.logo.height}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class={'logo lg-' + listing.logoTheme} aria-hidden="true">
        {listing.logoText}
      </span>
    )}
    <div class="card-id">
      <Heading><a href={url.listing(listing)}>{listing.name}</a></Heading>
      <p class="cat-line">
        {primary?.name}
        {home && <> &middot; {home.name}</>}
      </p>
    </div>
    {showState && home && (
      <span class={'state' + (home.state === 'VIC' ? ' vic' : '')}>{home.state}</span>
    )}
  </div>

  {/*
    Key facts, each one read off the listing. A missing rating just leaves the
    row to the facts that are there rather than apologising on every card.
  */}
  <ul class="facts">
    {rating && (
      <li class="fact fact-rate">
        <span class="i i-star" aria-hidden="true"></span>
        {rating.toFixed(1)} <span>({reviewCount})</span>
      </li>
    )}
    {listing.status === 'verified' && (
      <li class="fact fact-good">
        <span class="i i-check" aria-hidden="true"></span>
        Verified
      </li>
    )}
    {listing.status === 'claimed' && <li class="fact fact-good">Owner managed</li>}
    {weekend ? (
      <li class="fact fact-open">Open Saturdays</li>
    ) : openDays.length ? (
      <li class="fact">{openDays.length} {openDays.length === 1 ? 'day' : 'days'} a week</li>
    ) : (
      <li class="fact fact-muted">Hours not published</li>
    )}
    {listing.priceBand && <li class="fact">{listing.priceBand}</li>}
    {travelNote && (
      <li class="fact fact-cross">
        <span class="i i-swap" aria-hidden="true"></span>
        {travelNote}
      </li>
    )}
  </ul>

  <p class="desc">{fitDescription(listing.description, 155)}</p>

  <div class="card-foot">
    {listing.phone && (
      <a class="btn btn-sm btn-ghost card-call" href={'tel:' + listing.phone.replace(/[^0-9+]/g, '')} aria-label={'Call ' + listing.name}>
        <span class="i i-phone" aria-hidden="true"></span>
        Call
      </a>
    )}
    <a class="btn btn-sm card-more" href={url.listing(listing)} tabindex="-1" aria-hidden="true">Details</a>
  </div>
</article>
