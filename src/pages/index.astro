---
import {
  url,
  STATES,
  listings,
  localities,
  categories,
  guides,
  wire,
  tools,
  events,
  curatedLists,
  listingsInLocality,
  listingsInCategory,
  localitiesInState,
  activeCategoriesInLocality,
  getLocality,
  liveLocalities,
} from '~/lib/repo';
import { VERTICALS, SITE } from '~/lib/site';
import { getQuoteService } from '~/lib/quote-services';
import { quotePrimaryCount } from '~/lib/quotes';
import Base from '~/layouts/Base.astro';
import ListingCard from '~/components/ListingCard.astro';
import Faq from '~/components/Faq.astro';
import { n } from '~/lib/copy';
import { BUILD_DATE, shortDate } from '~/lib/build';
import {
  graph,
  organisationNode,
  websiteNode,
  webPageNode,
  faqNode,
  type Crumb,
} from '~/lib/seo';

const canonicalPath = url.home();

// liveLocalities() is the single source of truth for which towns have a page.
// Computing it a second way here is how the homepage started linking to towns
// that were never built.
const liveNsw = liveLocalities()
  .filter((l) => l.state === 'NSW')
  .map((l) => ({ locality: l, count: listingsInLocality(l.id).length }))
  .sort((a, b) => b.count - a.count);
const liveVic = liveLocalities()
  .filter((l) => l.state === 'VIC')
  .map((l) => ({ locality: l, count: listingsInLocality(l.id).length }))
  .sort((a, b) => b.count - a.count);

const verified = listings.filter((l) => l.status === 'verified').length;
const crossBorder = listings.filter((l) => {
  const home = getLocality(l.localityId);
  if (!home) return false;
  return l.serviceAreaIds.some((id) => {
    const a = getLocality(id);
    return a && a.state !== home.state;
  });
}).length;

// The biggest towns on each side, named in the eyebrow so the first line of the
// page says where this is before it says anything else.
const heroTowns = [liveNsw[0], liveVic[0], liveNsw[1], liveVic[1]]
  .filter(Boolean)
  .map((t) => t.locality.name)
  .filter((name, i, all) => all.indexOf(name) === i);

// The high value jobs the quote form handles, in the order people ask for them.
const heroServices = ['solar', 'builder', 'renovation', 'roofing', 'air-conditioning', 'home-loan']
  .map((s) => getQuoteService(s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
const bigJobs = ['solar', 'battery', 'builder', 'renovation', 'roofing', 'air-conditioning', 'landscaping', 'pool', 'home-loan', 'selling']
  .map((s) => getQuoteService(s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

// The flagship locality. Everything starts here and the homepage should say so.
const flagship = liveNsw[0]?.locality;
const flagshipCategories = flagship ? activeCategoriesInLocality(flagship.id).slice(0, 12) : [];
const featured = listings.slice().sort((a, b) => b.qualityScore - a.qualityScore).slice(0, 6);

const upcoming = events.filter((e) => e.startDate.slice(0, 10) >= BUILD_DATE).slice(0, 4);
const latestWire = wire.slice(0, 4);
const liveTools = tools.filter((t) => t.status === 'live').slice(0, 6);

// The two dropdowns in the hero. Both are built from what is actually live, so
// a category or a town with nothing in it never appears as a dead end choice.
const homeCategoryOptions = VERTICALS.map((v) => ({
  vertical: v,
  items: categories
    .filter((c) => c.vertical === v.key)
    .map((c) => ({ category: c, count: listingsInCategory(c.id).length }))
    .filter((c) => c.count > 0)
    .sort((a, b) => b.count - a.count || a.category.name.localeCompare(b.category.name)),
})).filter((g) => g.items.length > 0);

const homeSuburbOptions = (['NSW', 'VIC'] as const).map((code) => ({
  state: STATES[code],
  items: (code === 'NSW' ? liveNsw : liveVic)
    .slice()
    .sort((a, b) => a.locality.name.localeCompare(b.locality.name)),
}));

/**
 * The one snippet on the site that has to earn a click against Google Maps, so
 * it spends its characters on the two facts a reader cannot get there: the size
 * of the directory and the fact that service areas ignore the state line. The
 * previous wording ran to 171 characters and was being cut at "and…", which
 * dropped the differentiator and kept the ellipsis.
 */
const description =
  'Trades, cafes, pubs, places to stay and things to do across New South Wales and Victoria. ' +
  n(listings.length) +
  ' listings, with service areas that cross the border.';

const faqs = [
  {
    q: 'What makes LocalsKnow different from other directories?',
    a: 'Three things. Service area is stored separately from the registered address, so a business that works on both sides of the Murray appears on both sides of it. Trade licences are checked against the state registers and the date of the check is shown. And every fact on a listing carries the source it was read from.',
  },
  {
    q: 'Does paying money move a business up the list?',
    a: 'No. Ordering comes from a quality score built on profile completeness, claim status and licence verification. Promoted placement, where it exists, is boxed and labelled and never enters the structured data. The moment ranking is for sale the reason to trust the site is gone.',
  },
  {
    q: 'How much does a listing cost?',
    a: 'Nothing. Claiming, editing, adding hours and photos and replying to reviews are all free and stay free. Paid features are enquiry routing and multi location management, neither of which affects ordering.',
  },
  {
    q: 'Where does the information come from?',
    a: 'From businesses’ own websites and published material, from public registers, and from owners who claim their listing. Each page shows the sources and the date they were last read. If something is wrong, there is a correction link on every listing.',
  },
];

const jsonLd = graph([
  organisationNode(),
  websiteNode(),
  webPageNode({ pageUrl: canonicalPath, title: SITE.name, description, type: 'WebPage', dateModified: BUILD_DATE }),
  faqNode(faqs, canonicalPath),
]);
/*
 * The verticals as tiles. Every number on a tile is counted from the data, and
 * the links under each one are its categories with the most listings, so a
 * tile never offers a category with nothing in it.
 */
const VERTICAL_ICONS: Record<string, string> = {
  trades: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6Z',
  eat_drink: 'M4 8h13v5a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6V8Zm13 1h1.5a2.5 2.5 0 0 1 0 5H17M7 2v3m4-3v3m4-3v3',
  pubs_clubs: 'M5 8h11v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8Zm11 3h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2M5 8V6a3 3 0 0 1 3-3h5a3 3 0 0 1 3 3v2M9 12v5m3-5v5',
  stay: 'M2 19V5m0 9h20v5M2 19h20M6.5 11a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM11 14V9h7a4 4 0 0 1 4 4v1',
  things_to_do: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm3.5-13.5-2 5-5 2 2-5 5-2Z',
  clubs_hobbies: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8',
};
const verticalTiles = VERTICALS.map((v) => ({
  vertical: v,
  icon: VERTICAL_ICONS[v.key] ?? VERTICAL_ICONS.things_to_do,
  categoryCount: categories.filter((c) => c.vertical === v.key).length,
  listingCount: listings.filter((l) => l.vertical === v.key).length,
  top: (homeCategoryOptions.find((g) => g.vertical.key === v.key)?.items ?? []).slice(0, 5),
}));
---

<Base
  kind="home"
  title="Local business directory for Albury, Wodonga and the NSW and Victoria border"
  titleAlt={['Local business directory for Albury, Wodonga and the border', 'Business directory for NSW and Victoria']}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  modifiedAt={BUILD_DATE}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">{heroTowns.join(' · ')} &middot; and {liveNsw.length + liveVic.length - heroTowns.length} more towns</p>
      <h1>Find a local you can check, on <em>both sides</em> of the river.</h1>
      <p class="sub">
        LocalsKnow is an independent directory of {n(listings.length)} businesses across the
        New South Wales and Victoria border. Every listing shows where its facts came from,
        licences are checked against the state registers, and nobody can pay to be higher
        up the list.
      </p>

      <form class="search" action={url.search()} method="get" role="search">
        <div class="field">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <label class="visually-hidden" for="cat">What are you looking for</label>
          <select id="cat" name="cat">
            <option value="">What are you looking for?</option>
            {homeCategoryOptions.map((g) => (
              <optgroup label={g.vertical.name}>
                {g.items.map((c) => (
                  <option value={c.category.slug}>{c.category.name} ({c.count})</option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>
        <div class="field">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
          <label class="visually-hidden" for="loc">Suburb or town</label>
          <select id="loc" name="in">
            <option value="">Anywhere on the border</option>
            {homeSuburbOptions.map((g) => (
              <optgroup label={g.state.name}>
                {g.items.map((s) => (
                  <option value={s.locality.slug + '|' + s.locality.state}>
                    {s.locality.name} {s.locality.state} ({s.count})
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>
        <button class="btn" type="submit">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          Search
        </button>
      </form>
      <p class="hero-alt">
        Or <a href={url.search()}>search by name</a> if you already know who you are after.
      </p>

      {flagshipCategories.length > 0 && flagship && (
        <div class="chips">
          {flagshipCategories.slice(0, 8).map((c) => (
            <a class="chip" href={url.localityCategory(flagship, c.category)}>
              {c.category.name} in {flagship.name}
            </a>
          ))}
        </div>
      )}

      {/*
        The cross border count sits on its own rather than in the row of sizes.
        Every other number here is a size, and a size is something any directory
        can print. This one is the only figure on the page that could not exist
        without modelling service area apart from address, so it is the argument
        rather than a statistic, and it gets a full sentence.
      */}
      {crossBorder > 0 && (
        <p class="crossnote">
          <b>{crossBorder}</b>
          <span>
            businesses here work on both sides of the river. Every one of them is
            listed on both sides of it.
          </span>
        </p>
      )}

      <div class="statgrid">
        <div><b>{n(listings.length)}</b><span>listings</span></div>
        <div><b>{liveNsw.length + liveVic.length}</b><span>towns live</span></div>
        <div><b>{n(localities.length)}</b><span>localities mapped</span></div>
        <div><b>{categories.length}</b><span>categories</span></div>
        {verified > 0 && <div><b>{verified}</b><span>verified</span></div>}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head row">
        <div>
          <p class="kicker mono">Browse by what it is</p>
          <h2>Six kinds of local, each laid out for what it is</h2>
          <p>A pub and a plumber are not the same kind of thing and should not share a page layout, so each vertical has its own template, its own filters and its own schema type.</p>
        </div>
        <a class="more" href={url.categoryIndex()}>Every category</a>
      </div>
      <div class="vtiles">
        {verticalTiles.map((t) => (
          <article class="vtile">
            <div class="vtile-head">
              <span class="vtile-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon} /></svg>
              </span>
              <div>
                <h3><a href={url.vertical(t.vertical.slug)}>{t.vertical.name}</a></h3>
                <span class="vtile-n">
                  {t.categoryCount} categories{t.listingCount > 0 ? ' · ' + n(t.listingCount) + ' listings' : ''}
                </span>
              </div>
            </div>
            <p>{t.vertical.blurb}</p>
            {t.top.length > 0 && (
              <ul class="vtile-links">
                {t.top.map((c) => (
                  <li><a href={url.category(c.category)}>{c.category.name}</a></li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bigjobs">
    <div class="wrap">
      <div class="bigjobs-head">
        <div>
          <p class="mono bigjobs-eyebrow">Free quote matching</p>
          <h2>Big job coming up? Tell us once, get three quotes.</h2>
          <p>
            Answer a few quick questions and we pass your request to up to three local businesses
            that cover your town. You see who they are straight away, and nobody pays to be first.
          </p>
        </div>
        <a class="btn btn-gold btn-lg" href={url.quotes()}>See every service</a>
      </div>
      <div class="qservices bigjobs-grid">
        {bigJobs.map((s) => {
          const count = quotePrimaryCount(s);
          return (
            <a class="qservice" href={url.quote(s)}>
              <span class="qservice-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
              </span>
              <span class="qservice-text">
                <strong>{s.label}</strong>
                <span>{count > 0 ? `${n(count)} local ${s.who}` : `Local ${s.who}`}</span>
              </span>
              <svg class="qservice-go" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="border-story">
        <div>
          <p class="kicker mono">Why the border matters</p>
          <p class="border-story-big">The border is not the middle of the <em>river</em>.</p>
        </div>
        <p>
          It runs along the top of the southern bank, so the whole Murray sits in New South Wales.
          Every other directory draws it as a wall, which is how a Lavington plumber who works in
          Wodonga goes missing from half the searches they should own. Here, a business is listed
          in every town it actually services, on both sides.
        </p>
      </div>
      <div class="sec-head row">
        <div>
          <h2>Both sides of the Murray</h2>
          <p>Neighbouring towns are linked across the border on purpose. Albury links to Wodonga, not to another Albury suburb.</p>
        </div>
      </div>
      <div class="river-split">
        <div class="rs-side">
          <div class="rs-state">
            <h3>{STATES.NSW.name}</h3>
            <span class="state">NSW</span>
          </div>
          <ul class="townlist">
            {liveNsw.slice(0, 18).map((p) => (
              <li><a href={url.locality(p.locality)}>{p.locality.name} <span>{p.count}</span></a></li>
            ))}
          </ul>
          <a class="btn btn-ghost btn-sm" href={url.state('NSW')}>All of NSW</a>
        </div>
        <div class="river-line"><span class="mono">Murray</span></div>
        <div class="rs-side">
          <div class="rs-state">
            <h3>{STATES.VIC.name}</h3>
            <span class="state vic">VIC</span>
          </div>
          <ul class="townlist">
            {liveVic.slice(0, 18).map((p) => (
              <li><a href={url.locality(p.locality)}>{p.locality.name} <span>{p.count}</span></a></li>
            ))}
          </ul>
          <a class="btn btn-ghost btn-sm" href={url.state('VIC')}>All of Victoria</a>
        </div>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-head row">
          <div>
            <p class="kicker mono">Recently checked</p>
            <h2>The fullest profiles on the border</h2>
            <p>Ordered by how complete and how verified a profile is. Never by payment.</p>
          </div>
          <a class="more" href={url.search()}>Search everything</a>
        </div>
        <div class="cards">
          {featured.map((l) => <ListingCard listing={l} />)}
        </div>
      </div>
    </section>
  )}

  <section class="sec sec-band" id="how-we-check">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker mono">How we check</p>
        <h2>What we check, and what we will not claim</h2>
        <p>
          Four rules. Each one is enforced in the code that builds this site rather than
          stated in a policy and hoped for.
        </p>
      </div>
      <div class="trust">
        <article>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>
          </svg>
          <h3>A licence is checked, or it is not called checked</h3>
          <p>
            A number read off a business's own website is shown as exactly that. The
            verified badge only appears once we have put it through the state register,
            and the date of that check sits next to it.
          </p>
          <a href={url.verified()}>How verification works</a>
        </article>
        <article>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>
          </svg>
          <h3>Every fact carries its source</h3>
          <p>
            Each listing shows the URLs its details were read from and the date they were
            last read. {n(listings.length)} listings, {n(listings.filter((l) => l.confidence === 'high').length)} of them
            read from the business itself rather than a third party.
          </p>
          <a href={url.dataPolicy()}>Where the data comes from</a>
        </article>
        <article>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M12 17.8 5.8 21l1.2-6.9L2 9.2l7-1L12 2l3 6.2 7 1-5 4.9 1.2 6.9L12 17.8Z"/>
          </svg>
          <h3>No rating we cannot trace</h3>
          <p>
            A star rating only ever comes from the Google Places API and carries the date
            it was pulled. Where we do not have one, the page links to the business's
            Google profile instead of showing a number nobody can check.
          </p>
          <a href={url.editorialPolicy()}>Editorial policy</a>
        </article>
        <article>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
          </svg>
          <h3>Position is not for sale</h3>
          <p>
            Ordering comes from how complete a profile is, then rating, then name. No
            field a payment writes to reaches the sort. Promoted placement, where it
            exists, is boxed, labelled and kept out of the structured data.
          </p>
          <a href={url.advertisingPolicy()}>Advertising policy</a>
        </article>
      </div>
    </div>
  </section>

  {liveTools.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-head row">
          <div>
            <p class="kicker mono">Free tools</p>
            <h2>Free tools that actually compute</h2>
            <p>
              No signup, no gate, and nothing sent anywhere. Every one of these works out
              its answer in your browser from published rules, so they run with the network
              down and there is nothing to log.
            </p>
          </div>
          <a class="more" href={url.tools()}>All tools</a>
        </div>
        <div class="tools-grid">
          {liveTools.map((t) => (
            <a class="tool" href={url.tool(t)}>
              <span class="flag mono">Free</span>
              <h3>{t.title}</h3>
              <p>{t.standfirst}</p>
              <span class="go">Open the tool</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {(upcoming.length > 0 || latestWire.length > 0) && (
    <section class="sec">
      <div class="wrap">
        <div class="duo-grid">
          {upcoming.length > 0 && (
            <div class="listcard duo-card">
              <h2>What is on</h2>
              <p class="duo-sub">Markets, open days and come and try nights. Free to submit.</p>
              {upcoming.map((e) => (
                <div class="ev">
                  <div class="ev-date">
                    <b>{new Date(e.startDate).getUTCDate()}</b>
                    <span>{new Date(e.startDate).toLocaleDateString('en-AU', { month: 'short', timeZone: 'UTC' })}</span>
                  </div>
                  <div>
                    <h3><a href={url.event(e)}>{e.title}</a></h3>
                    <p>{e.description}</p>
                    <span class="where">{e.venueName}</span>
                  </div>
                </div>
              ))}
              <a class="more" href={url.events()}>All events</a>
            </div>
          )}
          {latestWire.length > 0 && (
            <div class="listcard duo-card">
              <h2>The wire</h2>
              <p class="duo-sub">How things actually work on the border, written by the desk.</p>
              <ul class="stack">
                {latestWire.map((w) => (
                  <li>
                    <a href={url.wireArticle(w)}>
                      <time datetime={w.publishedAt}>{shortDate(w.publishedAt)}</time>
                      <h3>{w.title}</h3>
                      <p>{w.description}</p>
                    </a>
                  </li>
                ))}
              </ul>
              <a class="more" href={url.wire()}>All of the wire</a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <div class="wrap">
    <Faq faqs={faqs} heading="How this works" />
  </div>

  <section class="claim-band">
    <div class="wrap">
      <div class="claim-in">
        <div>
          <h2>Your listing is probably already here.</h2>
          <p>
            Claim it and you can fix the details, add hours and photos, reply to reviews and
            see how many people looked you up. It costs nothing and it stays free.
          </p>
        </div>
        <div class="claim-actions">
          <a class="btn btn-gold btn-lg" href={url.claim()}>Claim a listing</a>
          <a class="btn btn-lg btn-on-dark" href={url.about()}>How we verify</a>
        </div>
      </div>
    </div>
  </section>
</Base>
