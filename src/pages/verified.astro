---
/**
 * The paid tier.
 *
 * The page has one job beyond selling: making the boundary unmissable. What is
 * for sale is the checking work and the features around it. The badge is not for
 * sale, and neither is position. If that ever stops being true, this page is the
 * first thing that has to change.
 */
import Base from '~/layouts/Base.astro';
import Faq from '~/components/Faq.astro';
import LinkBlock from '~/components/LinkBlock.astro';
import { url, listings } from '~/lib/repo';
import { SITE, PLANS } from '~/lib/site';
import { n } from '~/lib/copy';
import { BUILD_DATE } from '~/lib/build';
import {
  graph,
  organisationNode,
  websiteNode,
  breadcrumbNode,
  webPageNode,
  faqNode,
  type Crumb,
} from '~/lib/seo';

const canonicalPath = url.verified();
const h1 = 'Get verified';
const withLicence = listings.filter((l) => l.licences && l.licences.length > 0).length;

const description =
  'A monthly subscription that buys the licence checking work, not the badge. We check your licence against the state register, re-check it every month, and show the date.';

const crumbs: Crumb[] = [
  { name: 'Home', href: url.home() },
  { name: 'Get verified', href: canonicalPath },
];

const faqs = [
  {
    q: 'Am I paying for the badge?',
    a: 'No. You are paying for the work: pulling your licence, checking it against the state register, re-checking it every month and warning you before it expires. If the licence does not check out you do not get a badge, and the subscription does not change that. Selling the badge itself would make it worth nothing, which would make the subscription worth nothing too.',
  },
  {
    q: 'Does it move me up the results?',
    a: 'No. Ordering is computed from a completeness score, then rating, then business name. There is no field a payment writes to and no branch in the sorting code that reads a plan. Verification does raise the completeness score, in the same way and by the same amount as a free listing that passes a check would, which is a side effect and not the product.',
  },
  {
    q: 'Can I get verified without paying?',
    a: 'Yes. Claim your listing, add a licence number, and it goes into the free verification queue. That queue is slower and it is checked when we get to it rather than monthly. The subscription buys the speed, the monthly re-check and the expiry warning, not the outcome.',
  },
  {
    q: 'What happens if my licence lapses?',
    a: 'The badge comes off at the next monthly check and the listing says the licence is no longer current. We email you 60 days before the expiry date on the register so it should not come as a surprise. The subscription keeps running until you cancel it, which is deliberately the wrong way round for us: we would rather be obviously not worth paying for than quietly keep a badge up.',
  },
  {
    q: 'What if I do not hold a trade licence?',
    a: 'Then verification is not for you and the free listing is the whole product. A cafe does not need a builder licence and we are not going to invent a badge to sell one. ABN and business name verification is coming and it will be free.',
  },
  {
    q: 'Can I cancel?',
    a: 'Any time, from the dashboard, no phone call. The listing reverts to the free tier and keeps everything you put on it. Nothing you have written gets held hostage.',
  },
];

const jsonLd = graph([
  organisationNode(),
  websiteNode(),
  breadcrumbNode(crumbs, canonicalPath),
  webPageNode({
    pageUrl: canonicalPath,
    title: h1,
    description,
    crumbs,
    dateModified: BUILD_DATE,
  }),
  faqNode(faqs, canonicalPath),
]);
---

<Base
  kind="static"
  title="Get verified"
  description={description}
  canonicalPath={canonicalPath}
  crumbs={crumbs}
  jsonLd={jsonLd}
  modifiedAt={BUILD_DATE}
>
  <div class="wrap">
    <div class="pagehead">
      <p class="eyebrow mono">For business owners</p>
      <h1>{h1}</h1>
      <p class="standfirst">
        A monthly subscription that buys the checking work. We pull your licence, check
        it against the state register, check it again every month, and put the date on
        your listing so anyone can see how fresh it is.
      </p>
    </div>

    {!PLANS.live && (
      <div class="notice">
        <strong>Not open yet.</strong> Billing is not connected, so nobody can subscribe
        and nothing below can be bought today. The page is here so the terms are on the
        record before the product is. Tell us you want it and you will be first through
        the door, at the introductory price, whatever it has moved to by then.
      </div>
    )}

    <div class="plans">
      <section class="panel plan">
        <div class="panel-head">
          <h2>{PLANS.free.name}</h2>
          <span class="mono">Always</span>
        </div>
        <div class="panel-body">
          <p class="price"><b>$0</b><span>forever</span></p>
          <p style="color:var(--ink-60);font-size:14.5px">{PLANS.free.blurb}</p>
          <ul class="attrs plan-list">
            {PLANS.free.features.map((f) => <li>{f}</li>)}
          </ul>
          <a class="btn btn-ghost btn-block" style="margin-top:18px" href={url.claim()}>
            Claim your listing
          </a>
        </div>
      </section>

      <section class="panel plan featured">
        <div class="panel-head">
          <h2>{PLANS.verified.name}</h2>
          <span class="mono">{PLANS.live ? 'Available' : 'Opening soon'}</span>
        </div>
        <div class="panel-body">
          <p class="price">
            <b>${PLANS.verified.price}</b><span>per month, or ${PLANS.verified.priceAnnual} a year</span>
          </p>
          <p style="color:var(--ink-60);font-size:14.5px">{PLANS.verified.blurb}</p>
          <ul class="attrs plan-list">
            {PLANS.verified.features.map((f) => <li>{f}</li>)}
          </ul>

          <h3 style="font-size:14px;margin:22px 0 10px">What it explicitly does not buy</h3>
          <ul class="attrs plan-list no">
            {PLANS.verified.excludes.map((f) => <li>{f}</li>)}
          </ul>

          <a class="btn btn-gold btn-block" style="margin-top:20px" href="#register">
            {PLANS.live ? 'Start verification' : 'Tell us you want it'}
          </a>
        </div>
      </section>
    </div>

    <div class="prose" style="margin-top:44px">
      <h2>Why the badge is not the product</h2>
      <p>
        Every directory in the country sells a trust badge. That is why nobody believes
        one. The moment a badge is something you buy rather than something you pass, it
        stops carrying information, and a reader who works that out discounts every badge
        on the site including the honest ones.
      </p>
      <p>
        So the thing being sold here is the work, and the work has an outcome that is not
        guaranteed. We check your licence against
        <a href="https://verify.licence.nsw.gov.au/" rel="noopener">NSW Fair Trading</a> or
        the <a href="https://www.vba.vic.gov.au/" rel="noopener">Victorian Building Authority</a>,
        we record the date, and we do it again every month. If it checks out, the badge
        goes on and the date goes with it. If it does not, it does not, and you can cancel.
      </p>
      <p>
        Of the {n(listings.length)} businesses currently listed, {n(withLicence)} have
        published a licence number we could read off their own material. None of those are
        shown as verified yet, because reading a number off a website is not checking it.
        That distinction is the entire proposition.
      </p>

      <h2>What a check actually involves</h2>
      <ol>
        <li>You give us the licence number and the state it was issued in.</li>
        <li>We query the public register for that state and record what came back: the holder, the class, the status and the expiry.</li>
        <li>If the holder name does not match your business, we ask you about it before doing anything. There are legitimate reasons and we would rather ask than guess.</li>
        <li>The badge appears with the date of the check on it, on your listing and on every results page you appear on.</li>
        <li>It repeats monthly. The date on the badge is always the date of the last check, never the date of the first one.</li>
        <li>Sixty days before the expiry on the register, you get an email.</li>
      </ol>

      <h2>What the badge means to a reader</h2>
      <p>
        Exactly what the <a href={url.terms()}>terms</a> say it means and nothing more:
        that on the date shown, that number returned as current for that class of work.
        Not that you are insured, not that you are good, not that we recommend you. A
        badge that claimed any of those would be a claim we cannot stand behind, and one
        we could not defend if somebody asked us to.
      </p>

      <h2>Ordering, again, because it matters</h2>
      <p>
        Results are ordered by how complete a profile is, then by rating, then by name.
        Verification is one input into completeness, worth the same whether it was paid
        for or came through the free queue. There is no paid position, there is no bidding,
        and promoted placement, when it exists, will sit in its own labelled box outside the
        list and outside the structured data. That is set out in the
        <a href={url.advertisingPolicy()}>advertising policy</a> and it is enforced in the
        ranking function, not in a promise.
      </p>
    </div>

    <section class="panel" id="register" style="margin-top:40px">
      <div class="panel-head">
        <h2>{PLANS.live ? 'Start verification' : 'Register your interest'}</h2>
      </div>
      <div class="panel-body">
        <p style="margin:0 0 18px;color:var(--ink-60);font-size:14.5px">
          {PLANS.live
            ? 'Tell us the business and the licence number and we will run the first check within two business days.'
            : 'No payment details, no obligation. We will email you once when it opens and not for any other reason.'}
        </p>
        <form name="verified" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="verified" />
          <input type="hidden" name="subject" value="LocalsKnow verification enquiry" />
          <p hidden><label>Leave this empty: <input name="bot-field" /></label></p>
          <div class="formgrid">
            <label>
              <span>Business name</span>
              <input type="text" name="business" required />
            </label>
            <label>
              <span>Your name</span>
              <input type="text" name="name" required />
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="email" required />
            </label>
            <label>
              <span>Phone</span>
              <input type="tel" name="phone" />
            </label>
            <label>
              <span>Licence number, if you hold one</span>
              <input type="text" name="licence" />
            </label>
            <label>
              <span>Issued in</span>
              <select name="licence_state">
                <option value="">Not applicable</option>
                <option value="NSW">New South Wales</option>
                <option value="VIC">Victoria</option>
              </select>
            </label>
          </div>
          <label style="display:block;margin-top:16px">
            <span style="display:block;font-size:13.5px;font-weight:500;margin-bottom:6px">Anything else</span>
            <textarea name="message" rows="3"></textarea>
          </label>
          <button class="btn btn-gold" type="submit" style="margin-top:18px">
            {PLANS.live ? 'Start verification' : 'Put me on the list'}
          </button>
        </form>
        <p style="margin:14px 0 0;font-size:13px;color:var(--ink-40)">
          What happens to what you type is set out in the
          <a href={url.privacy()} style="color:var(--river)">privacy policy</a>.
        </p>
      </div>
    </section>

    <Faq faqs={faqs} heading="Questions about verification" />
  </div>

  <LinkBlock
    groups={[
      {
        heading: 'Before you decide',
        links: [
          { href: url.advertisingPolicy(), label: 'How ordering actually works' },
          { href: url.terms(), label: 'What a verified badge means, in the terms' },
          { href: '/wire/what-a-verified-badge-actually-means/', label: 'The longer version' },
          { href: '/wire/how-listing-quality-is-scored/', label: 'How the quality score is built' },
        ],
      },
      {
        heading: 'Free first',
        links: [
          { href: url.claim(), label: 'Claim your listing' },
          { href: '/tools/licence-check/', label: 'Check your own licence now' },
          { href: url.contact(), label: 'Ask us something' },
        ],
      },
    ]}
  />

  <style>
    .plans {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 30px;
      align-items: start;
    }
    @media (max-width: 820px) {
      .plans {
        grid-template-columns: 1fr;
      }
    }
    .plan.featured {
      border-color: var(--wattle);
      box-shadow: 0 0 0 1px var(--wattle);
    }
    .price {
      margin: 0 0 12px;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .price b {
      font-family: var(--font-mono);
      font-size: 34px;
      font-weight: 500;
      letter-spacing: -0.03em;
    }
    .price span {
      color: var(--ink-40);
      font-size: 13.5px;
    }
    .plan-list {
      flex-direction: column;
      display: flex;
      gap: 6px;
      margin-top: 14px;
    }
    .plan-list li {
      border: 0;
      background: none;
      padding: 0;
      border-radius: 0;
      font-size: 14.5px;
      color: var(--ink-80);
    }
    .plan-list.no li::before {
      content: '×';
      color: var(--clay);
    }
    .formgrid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    @media (max-width: 640px) {
      .formgrid {
        grid-template-columns: 1fr;
      }
    }
    .formgrid label,
    #register textarea {
      display: block;
    }
    .formgrid label span {
      display: block;
      font-size: 13.5px;
      font-weight: 500;
      margin-bottom: 6px;
    }
    #register input,
    #register select,
    #register textarea {
      font: inherit;
      font-size: 14.5px;
      padding: 11px 13px;
      border: 1px solid var(--line);
      border-radius: var(--r);
      background: var(--paper-2);
      color: var(--ink);
      outline: none;
      width: 100%;
    }
    #register input:focus,
    #register select:focus,
    #register textarea:focus {
      border-color: var(--river);
      background: var(--white);
    }
  </style>
</Base>
