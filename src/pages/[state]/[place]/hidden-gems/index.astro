---
/**
 * Hidden gems.
 *
 * The honest version of a page that is usually dishonest. Nobody here has been
 * to these places, so the selection is not "our favourites". It is everything
 * that a normal search will not surface, chosen by rules stated on the page:
 *
 *   - free public places, which no directory promotes because nobody pays for them
 *   - community clubs and groups, which almost no directory lists at all
 *   - specialty and independent retail, which loses to the chains on every query
 *   - anything in a category with fewer than four listings, because a thin
 *     category never ranks and so its entries are effectively invisible
 *   - in a small town, the only one of its kind, which is the single most
 *     useful thing to know about a village and the thing no directory says
 *
 * The rules live in hiddenGemsIn() rather than here, so the route, the links
 * to it and this page cannot disagree about which towns have one.
 *
 * Everything is drawn from businesses actually based in the town. Drawing from
 * everything that merely covers it produced, for a suburb, a page of the next
 * town's businesses under a different heading.
 */
import Base from '~/layouts/Base.astro';
import Faq from '~/components/Faq.astro';
import LinkBlock from '~/components/LinkBlock.astro';
import ListingCard from '~/components/ListingCard.astro';
import {
  url,
  STATES,
  hiddenGemLocalities,
  hiddenGemsIn,
  hasHiddenGems,
  townProfile,
  getRegion,
  neighboursOf,
  hasLocalityEvents,
} from '~/lib/repo';
import type { Locality } from '~/lib/types';
import { n, plural } from '~/lib/copy';
import { BUILD_DATE } from '~/lib/build';
import {
  graph,
  organisationNode,
  websiteNode,
  breadcrumbNode,
  webPageNode,
  placeNode,
  faqNode,
  itemListNode,
  listingNode,
  ogForState,
  type Crumb,
} from '~/lib/seo';

export async function getStaticPaths() {
  // Every town with at least one qualifying place, which is 47 of the 48 live
  // ones. Not every live town: a "hidden gems" page listing nothing is worse
  // than no page, and the soft page redirect in postbuild sends the remainder
  // to their town hub rather than a 404.
  return hiddenGemLocalities().map((locality) => ({
    params: { state: STATES[locality.state].slug, place: locality.slug },
    props: { locality },
  }));
}

const { locality } = Astro.props as { locality: Locality };
const state = STATES[locality.state];
const region = getRegion(locality.regionId);
const canonicalPath = url.locality(locality) + 'hidden-gems/';

const profile = townProfile(locality);
const picked = hiddenGemsIn(locality.id);
const hub = profile.hub;

// Grouped so the page reads as a set of arguments rather than one long list.
// The group a gem lands in is its stated reason, so the grouping and the
// selection cannot disagree.
const REASON_GROUPS = [
  'Free, so nobody advertises it',
  'A club, and clubs are invisible on every other directory',
  'Independent retail, which loses every search to the chains',
  'In a category too small to rank, so it never surfaces',
  'The only one of its kind based in town',
];
const GROUP_HEADINGS: Record<string, string> = {
  'Free, so nobody advertises it': 'Free, and nobody is advertising it',
  'A club, and clubs are invisible on every other directory': 'Clubs and groups',
  'Independent retail, which loses every search to the chains': 'Independent and specialty',
  'In a category too small to rank, so it never surfaces': 'One of a kind here',
  'The only one of its kind based in town': 'The only one in town',
};
const groups = REASON_GROUPS.map((reason) => ({
  key: GROUP_HEADINGS[reason],
  items: picked.filter((g) => g.reason === reason),
})).filter((g) => g.items.length > 0);

const nearby = neighboursOf(locality, 10).filter((nb) => hasHiddenGems(nb.locality.id)).slice(0, 6);

/*
 * The hub button has to ask the same question the nearby list asks.
 *
 * The nearby list filters on hasHiddenGems and the "Further afield" button did
 * not, so the moment Shepparton arrived with fifty one listings and not one of
 * them qualifying as a gem, Mooroopna linked to a page that was never built.
 * This is the bug class in the README, for the sixth time: a predicate deciding
 * whether a page exists lives in repo.ts and everything that links to that page
 * asks it. The prose about the nearest larger centre is still worth keeping when
 * that centre has no page, so it is the link that is conditional, not the block.
 */
const hubHasGems = Boolean(hub && hasHiddenGems(hub.locality.id));

const h1 = 'Hidden gems in ' + locality.name;
const description =
  n(picked.length) +
  ' ' +
  plural(picked.length, 'place', 'places') +
  ' in ' +
  locality.name +
  ' ' +
  locality.state +
  ' that an ordinary search will not show you: the free ones, the clubs, the independents and the one of a kind.';

const crumbs: Crumb[] = [
  { name: 'Home', href: url.home() },
  { name: state.name, href: url.state(locality.state) },
  ...(region ? [{ name: region.name, href: url.region(region) }] : []),
  { name: locality.name, href: url.locality(locality) },
  { name: 'Hidden gems', href: canonicalPath },
];

const faqs = [
  {
    q: 'Have you actually been to these places?',
    a: 'No, and the page does not pretend otherwise. Nothing here is a review. The selection is made by rules that are printed at the top of the page, from listings whose details were read from published sources, and every entry shows where those came from and when.',
  },
  {
    q: 'How were these chosen?',
    a: 'Five rules, applied to every business based in ' + locality.name + '. Free public places, because nobody promotes what they cannot charge for. Community clubs, because almost no directory lists them. Independent and specialty retail, because it loses every search to a chain. Anything in a category with fewer than four listings, because a category that thin never ranks, so its entries are effectively invisible. And in a small town, the only one of its kind. Note the word based: a business that merely drives here is on the town page, but it is not one of the gems of the town itself.',
  },
  {
    q: 'Did anyone pay to be on this list?',
    a: 'No, and they cannot. There is no field a payment writes to anywhere in the ordering on this site, and this page is generated from the same rules for every town. If that ever changes it will say so on the page before it changes, not after.',
  },
  {
    q: 'Something obvious is missing.',
    a: 'Then either we do not list it yet, or it is popular enough that an ordinary search already finds it, which is the whole point of this page. Tell us either way and we will add it.',
  },
];

const jsonLd = graph([
  organisationNode(),
  websiteNode(),
  breadcrumbNode(crumbs, canonicalPath),
  webPageNode({
    pageUrl: canonicalPath,
    title: h1,
    description,
    crumbs,
    type: 'CollectionPage',
    dateModified: BUILD_DATE,
  }),
  placeNode(locality, region),
  itemListNode({
    pageUrl: canonicalPath,
    name: h1,
    items: picked.slice(0, 40).map((x) => ({ url: url.listing(x.listing), name: x.listing.name })),
  }),
  faqNode(faqs, canonicalPath),
]);
---

<Base
  kind="townGuide"
  basedCount={profile.based.length}
  title={'Hidden gems in ' + locality.name + ', ' + locality.state}
  description={description}
  canonicalPath={canonicalPath}
  crumbs={crumbs}
  jsonLd={jsonLd}
  listingCount={picked.length}
  ogImage={ogForState(locality.state)}
  modifiedAt={BUILD_DATE}
>
  <div class="wrap">
    <div class="pagehead">
      <p class="eyebrow mono">{locality.name} &middot; {state.name}</p>
      <h1>{h1}</h1>
      <p class="standfirst">
        Not our favourites, because we have not been to them. These are the
        {' '}{n(picked.length)} {plural(picked.length, 'place', 'places')} in {locality.name} that an ordinary search will not
        put in front of you, picked by five rules that are written out below rather than
        left to taste. Every one of them is based in {locality.name}, not merely willing to
        drive here.
      </p>
      <div class="headmeta">
        <span>{n(picked.length)} {plural(picked.length, 'place', 'places')}</span>
        <span>&middot; {groups.length} {plural(groups.length, 'reason it is missed', 'reasons they are missed')}</span>
        <span>&middot; Checked {BUILD_DATE}</span>
      </div>
    </div>

    <div class="notice">
      <strong>How this list was made.</strong> Free public places, because nobody promotes
      what they cannot charge for. Community clubs, because almost no directory lists them
      at all. Independent and specialty retail, because it loses every search to a chain.
      Anything in a category with fewer than four listings, because a category that thin
      never ranks, so what is in it is effectively invisible. And in a town this size, the
      only one of its kind, which is the thing you most want to know about a village and
      the thing no directory tells you. Nothing here was paid for and nothing here is a
      review.
    </div>
  </div>

  {picked.length === 0 ? (
    <div class="wrap">
      <div class="empty">
        <p>Nothing qualifies in {locality.name} yet. That usually means the club and free
        attraction listings have not been built for this town.</p>
        <a class="btn" href={url.claim()}>Add one</a>
      </div>
    </div>
  ) : (
    groups.map((g) => (
      <section class="sec">
        <div class="wrap">
          <div class="sec-head">
            <h2>{g.key}</h2>
            <p>{g.items.length} in {locality.name}.</p>
          </div>
          <div class="cards">
            {g.items.slice(0, 12).map((x) => <ListingCard listing={x.listing} context={locality} />)}
          </div>
        </div>
      </section>
    ))
  )}

  {hub && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <h2>Further afield</h2>
          <p>
            {picked.length < 4
              ? locality.name + ' is small, so this list is short by nature rather than by neglect. '
              : ''}
            The nearest larger centre is {hub.locality.name}, about {Math.round(hub.distanceKm)}km
            away{hub.crossesBorder ? ' and across the border' : ''}.{' '}
            {hubHasGems
              ? "Its gems are listed separately rather than folded in here, because a page that quietly borrows the next town's businesses stops being about this town at all."
              : 'Nothing there has qualified for a list like this one yet, so there is nowhere to send you but its town page.'}
          </p>
        </div>
        <p>
          <a
            class="btn"
            href={hubHasGems ? url.locality(hub.locality) + 'hidden-gems/' : url.locality(hub.locality)}
          >
            {hubHasGems ? 'Hidden gems in ' + hub.locality.name : 'Everything in ' + hub.locality.name}
          </a>
        </p>
      </div>
    </section>
  )}

  <div class="wrap">
    <Faq faqs={faqs} heading="About this list" />
  </div>

  <LinkBlock
    groups={[
      {
        heading: 'More of ' + locality.name,
        links: [
          { href: url.locality(locality) + 'new-in-town/', label: 'New in ' + locality.name + '? Start here' },
          { href: url.locality(locality), label: 'Everything in ' + locality.name },
          ...(hasLocalityEvents(locality.slug)
            ? [{ href: url.localityEvents(locality), label: 'What is on in ' + locality.name }]
            : [{ href: url.events(), label: 'Events across the border' }]),
        ],
      },
      {
        heading: 'Nearby',
        links: nearby.map((nb) => ({
          href: url.locality(nb.locality) + 'hidden-gems/',
          label: 'Hidden gems in ' + nb.locality.name,
          note: nb.crossesBorder ? nb.locality.state : Math.round(nb.distanceKm) + 'km',
          cross: nb.crossesBorder,
        })),
      },
    ]}
  />
</Base>
