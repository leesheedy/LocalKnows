---
import MoneyPage from '~/components/MoneyPage.astro';
import {
  STATES,
  liveLocalities,
  activeCategoriesInLocality,
  listingsInLocalityCategory,
  localityCategoryStats,
  POLICY,
} from '~/lib/repo';
import { BUILD_DATE, chunk } from '~/lib/build';

export async function getStaticPaths() {
  const paths = [];
  for (const locality of liveLocalities()) {
    for (const { category } of activeCategoriesInLocality(locality.id)) {
      const rows = listingsInLocalityCategory(locality.id, category.id);
      const pages = chunk(rows, POLICY.perPage);
      if (pages.length < 2) continue;
      const stats = localityCategoryStats(locality.id, category.id);
      pages.forEach((slice, i) => {
        if (i === 0) return;
        paths.push({
          params: {
            state: STATES[locality.state].slug,
            place: locality.slug,
            category: category.slug,
            page: String(i + 1),
          },
          props: {
            locality,
            category,
            listings: slice,
            stats,
            page: i + 1,
            totalPages: pages.length,
          },
        });
      });
    }
  }
  return paths;
}

const { locality, category, listings, stats, page, totalPages } = Astro.props;
---
<MoneyPage
  locality={locality}
  category={category}
  listings={listings}
  stats={stats}
  page={page}
  totalPages={totalPages}
  buildDate={BUILD_DATE}
/>
