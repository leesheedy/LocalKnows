---
/**
 * /nsw/albury/plumbers/  and  /nsw/albury/nightlife/
 *
 * A category page and a themed page sit at the same URL depth, so they share a
 * route and getStaticPaths decides which is which. Two dynamic routes competing
 * for one segment is a collision, not a feature.
 */
import MoneyPage from '~/components/MoneyPage.astro';
import ThemePage from '~/components/ThemePage.astro';
import {
  STATES,
  liveLocalities,
  activeCategoriesInLocality,
  listingsInLocality,
  listingsInLocalityCategory,
  localityCategoryStats,
  themesFor,
  POLICY,
} from '~/lib/repo';
import { BUILD_DATE, chunk } from '~/lib/build';

export async function getStaticPaths() {
  const paths: any[] = [];

  for (const locality of liveLocalities()) {
    for (const { category } of activeCategoriesInLocality(locality.id)) {
      const rows = listingsInLocalityCategory(locality.id, category.id);
      if (!rows.length) continue;
      paths.push({
        params: {
          state: STATES[locality.state].slug,
          place: locality.slug,
          category: category.slug,
        },
        props: {
          type: 'category',
          locality,
          category,
          listings: chunk(rows, POLICY.perPage)[0],
          stats: localityCategoryStats(locality.id, category.id),
          page: 1,
          totalPages: Math.max(1, Math.ceil(rows.length / POLICY.perPage)),
        },
      });
    }

    // Themed pages. themesFor() owns the thresholds so the route and every link
    // to it ask the same question, which is the bug class that has bitten this
    // codebase four times now.
    for (const theme of themesFor(locality.id)) {
      paths.push({
        params: {
          state: STATES[locality.state].slug,
          place: locality.slug,
          category: theme.slug,
        },
        props: { type: 'theme', locality, themeSlug: theme.slug },
      });
    }
  }

  return paths;
}

const props = Astro.props as any;
---
{props.type === 'theme' ? (
  <ThemePage locality={props.locality} themeSlug={props.themeSlug} />
) : (
  <MoneyPage
    locality={props.locality}
    category={props.category}
    listings={props.listings}
    stats={props.stats}
    page={props.page}
    totalPages={props.totalPages}
    buildDate={BUILD_DATE}
  />
)}
